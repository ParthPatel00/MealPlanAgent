# Copy this to .env and fill in keys as needed

# Groq (free tier: https://console.groq.com)
# Only needed if using groq-llama model
GROQ_API_KEY=your_groq_key_here

# Default model: ollama-llama3b | ollama-granite2b | groq-llama
DEFAULT_MODEL=ollama-llama3b

# RAG settings
CHROMA_DB_PATH=data/chroma_db
RECIPES_CSV_PATH=data/RAW_recipes.csv
MAX_RECIPES=10000
TOP_K_RETRIEVAL=10
